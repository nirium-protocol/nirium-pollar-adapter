{
  "name": "nirium-pollar-adapter",
  "version": "0.5.0",
  "description": "Nirium adapter for the Pollar SDK — x402 pay-per-request and IPFS audit anchoring using the wallet a user onboarded through Pollar. Signs SEP-43 auth entries; the facilitator sponsors network fees. Includes Deferred-mode wallet activation (POST /v1/wallets/activate).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.3.0",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/stellar": "2.28.0"
  },
  "peerDependencies": {
    "@pollar/core": "^0.11.4"
  },
  "peerDependenciesMeta": {
    "@pollar/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pollar/core": "0.11.4",
    "@types/node": "^20.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "nirium",
    "pollar",
    "stellar",
    "soroban",
    "x402",
    "adapter"
  ],
  "homepage": "https://nirium.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirium-protocol/nirium-pollar-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/nirium-protocol/nirium-pollar-adapter/issues"
  },
  "license": "Apache-2.0"
}
