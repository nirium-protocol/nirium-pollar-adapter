{
  "name": "nirium-pollar-adapter",
  "version": "0.6.4",
  "description": "Let Pollar users who sign in with email or Google pay per request (x402) on Stellar and get a receipt anyone can verify. The facilitator sponsors network fees.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.4.1",
    "@x402/core": "2.31.0",
    "@x402/fetch": "2.31.0",
    "@x402/stellar": "2.31.0"
  },
  "peerDependencies": {
    "@pollar/core": ">=0.11.4 <0.13.0"
  },
  "peerDependenciesMeta": {
    "@pollar/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pollar/core": "0.12.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "stellar",
    "x402",
    "usdc",
    "payments",
    "pay-per-request",
    "ai-agents",
    "agentic-payments",
    "receipts",
    "audit-trail",
    "pollar"
  ],
  "homepage": "https://nirium.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirium-protocol/nirium-pollar-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/nirium-protocol/nirium-pollar-adapter/issues"
  },
  "license": "Apache-2.0"
}
